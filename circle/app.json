{
  "expo": {
    "name": "Nyoni Circle",
    "slug": "nyoni-circle",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nyonicircle",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#080808",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nyonicouture.circle"
    },
    "android": {
      "package": "com.nyonicouture.circle",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#080808"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080808",
          "dark": {
            "backgroundColor": "#080808"
          },
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nyoni Circle uses your photos so you can preview a piece on yourself and add garments you already own.",
          "cameraPermission": "Nyoni Circle uses your camera so you can photograph a garment or take the portrait your previews are built from."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    }
  }
}
